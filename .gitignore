# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/

# Test coverage
.coverage
.pytest_cache/
htmlcov/

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# Type checking
.mypy_cache/

# OS files
.DS_Store
Thumbs.db

# pyenv
.python-version

# PR descriptions (temporary reference documents)
.github/pr_descriptions/*
!.github/pr_descriptions/pull_request_template.md

# Demo tapes and generated outputs (VHS); README, tapes, demo asset tracked; output/ for GIFs/MP4s
docs/demos/*
!docs/demos/README.md
!docs/demos/tapes/
!docs/demos/sample.mp3

# Article demos (e.g. content/articles/one_to_rule): VHS GIFs, ffmpeg MP4s, concat lists — same policy as docs/demos/output/
content/articles/*/output/

# Node.js (for git-worktree-scripts dev dependency)
node_modules/
package-lock.json

DESIGN_PATTERNS.md
INTERVIEW_PATTERNS.md