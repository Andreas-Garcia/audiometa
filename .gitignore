# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/

# Test coverage
.coverage
.pytest_cache/
htmlcov/

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# Type checking
.mypy_cache/

# OS files
.DS_Store
Thumbs.db

# pyenv
.python-version

# PR descriptions (temporary reference documents)
.github/pr_descriptions/*
!.github/pr_descriptions/pull_request_template.md

# Content articles: build output and generated/temp files (tapes tracked; sample.mp3/flac stay tracked if already committed)
content/**/output/
content/articles/**/*.gif
content/articles/**/*.mp4
content/articles/**/*.wav
content/articles/**/*.flac
content/articles/**/*.mp3

# Article demos (per folder under content/articles/<name>/): ignore loose/generated files;
# track README/scenario .md, tapes/, shell/Python helpers; whitelisted demo audio only under samples/ (below).
content/articles/*/*
!content/articles/*/*.md
!content/articles/*/*.sh
!content/articles/*/*.py
!content/articles/*/tapes/
!content/articles/*/samples/
content/articles/*/samples/*
!content/articles/*/samples/README.md
!content/articles/*/samples/sample.mp3
!content/articles/*/samples/sample.flac
!content/articles/*/samples/sample.wav

# one_to_rule: hero video + helpers live next to tapes (not under scripts/); keep tracked explicitly.
!content/articles/one_to_rule/generate_one_to_rule_video.sh
!content/articles/one_to_rule/run_vhs_tape.sh
!content/articles/one_to_rule/run_demo_side_by_side.sh
!content/articles/one_to_rule/run_demo_side_by_side_vorbis.sh
!content/articles/one_to_rule/sync_article_sample_metadata.py

# Node.js (for git-worktree-scripts dev dependency)
node_modules/
package-lock.json

DESIGN_PATTERNS.md
INTERVIEW_PATTERNS.md