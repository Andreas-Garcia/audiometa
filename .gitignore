# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/

# Test coverage
.coverage
.pytest_cache/
htmlcov/

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# Type checking
.mypy_cache/

# OS files
.DS_Store
Thumbs.db

# pyenv
.python-version

# PR descriptions (temporary reference documents)
.github/pr_descriptions/*
!.github/pr_descriptions/pull_request_template.md

# Content articles: build output and generated/temp files (tapes tracked; sample.mp3/flac stay tracked if already committed)
content/**/output/
